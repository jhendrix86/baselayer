# =============================================================================
# BaseLayer Development Caddy Configuration
# =============================================================================
# For local development with self-signed certificates
# =============================================================================

{
	# Global options
	auto_https off
	admin localhost:2019
	log {
		output file /var/log/caddy/access.log
		format json
	}
}

# =============================================================================
# Development HTTP Server
# =============================================================================
:80 {
	# Development logging
	log {
		output file /var/log/caddy/dev-access.log
		format console
	}

	# Development headers
	header {
		# CORS headers for development
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		Access-Control-Allow-Headers "*"
		Access-Control-Allow-Credentials true
		Access-Control-Max-Age 86400

		# Security headers (relaxed for development)
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Handle preflight requests
	@options method OPTIONS
	respond @options 200

	# Routed with explicit "handle" blocks, not bare matched directives:
	# handle blocks are documented to be mutually exclusive and evaluated
	# strictly in the order written (first match wins, no fallthrough) -
	# unambiguous, unlike relying on Caddy's directive-sorting for repeated
	# bare "reverse_proxy" blocks. Tried the bare-directive + reordering
	# approach first (2026-08-14, real Docker host) and it did NOT fix the
	# actual bug (confirmed empirically: /health/health still 500'd even
	# with the specific matcher listed before the frontend catch-all in
	# the file), so switched to this more explicit, Caddy-recommended
	# pattern instead of continuing to guess at ordering semantics.
	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto http
		}
	}
	handle /health/* {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto http
		}
	}
	handle /metrics/* {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto http
		}
	}
	handle /adminer* {
		reverse_proxy adminer:8080
	}
	handle /redis* {
		reverse_proxy redis-commander:8081
	}
	handle /static/* {
		root * /var/www/static
		file_server
	}
	# Frontend development server - catch-all fallback, must stay last.
	handle {
		reverse_proxy frontend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto http
		}
	}
}

# =============================================================================
# Development HTTPS Server (self-signed)
# =============================================================================
:443 {
	# Development logging
	log {
		output file /var/log/caddy/dev-https-access.log
		format console
	}

	# Self-signed certificate for development
	tls internal

	# Development headers
	header {
		# CORS headers for development
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		Access-Control-Allow-Headers "*"
		Access-Control-Allow-Credentials true
		Access-Control-Max-Age 86400

		# Security headers (relaxed for development)
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Handle preflight requests
	@options method OPTIONS
	respond @options 200

	# Routed with explicit "handle" blocks - see the identical comment in
	# the :80 block above for why (mutually exclusive, strict written
	# order, unlike bare repeated reverse_proxy directives).
	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}
	handle /health/* {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}
	handle /metrics/* {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}
	handle /adminer* {
		reverse_proxy adminer:8080
	}
	handle /redis* {
		reverse_proxy redis-commander:8081
	}
	handle /static/* {
		root * /var/www/static
		file_server
	}
	# Frontend development server - catch-all fallback, must stay last.
	handle {
		reverse_proxy frontend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}
}

# =============================================================================
# Admin Interface
# =============================================================================
localhost:2019 {
	bind localhost
}

# =============================================================================
# Import additional configurations
# =============================================================================
# Uncomment to include additional config files
# import config/*.caddy
