# =============================================================================
# BaseLayer Frontend Dockerfile
# =============================================================================
# Builds the Vite/React SPA in frontend/ and serves the static bundle over
# nginx on :3000 — the port the dev Caddyfile's catch-all
# (`handle { reverse_proxy frontend:3000 }`) proxies to.
#
# Multi-stage; the final stage is named `production` because
# infra/docker-compose.prod.yml builds this file with `target: production`
# (infra/docker-compose.dev.yml does the same). Build context is the
# baselayer repo root — compose sets `context: ..`.
# =============================================================================

# =============================================================================
# Build Stage — compile the SPA
# =============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# pnpm via corepack (bundled with node:20). 8.7.0 is the version the
# committed frontend/pnpm-lock.yaml was generated with (frontend/'s
# engines.pnpm is ">=8.0.0"; there's no packageManager field to read).
RUN corepack enable && corepack prepare pnpm@8.7.0 --activate

# Dependency layer first, keyed on the lockfile, so source-only changes
# don't re-run the install.
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Build inputs (explicit, matching infra/Dockerfile's selective-COPY style —
# avoids pulling the host's frontend/node_modules or frontend/dist into the
# image and clobbering the installed deps).
COPY frontend/tsconfig.json frontend/tsconfig.node.json ./
COPY frontend/index.html frontend/vite.config.ts ./
COPY frontend/postcss.config.js frontend/tailwind.config.js ./
COPY frontend/src ./src

# tsc && vite build -> /app/dist
RUN pnpm build

# =============================================================================
# Production Stage — serve the static bundle
# =============================================================================
FROM nginx:alpine AS production

# :3000 listener + SPA history fallback (replaces the stock :80 site).
COPY infra/config/nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 3000

# nginx:alpine ships busybox wget.
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
